{
  "name": "focus-kids",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "专注力小卫士 —— 6~10 岁儿童专注力训练系统",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsx scripts/check-docs.ts && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "vue-tsc --noEmit",
    "check:docs": "tsx scripts/check-docs.ts",
    "check": "npm run typecheck && npm run check:docs"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "echarts": "^5.6.0",
    "hono": "^4.9.7",
    "pinia": "^3.0.3",
    "tsx": "^4.20.5",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vue-tsc": "^3.0.6"
  }
}
